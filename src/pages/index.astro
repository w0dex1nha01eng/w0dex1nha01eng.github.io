---
import BaseLayout from '../layouts/BaseLayout.astro';
import PathNav from '../components/PathNav.astro';
import PostList from '../components/PostList.astro';
import asukaArt from '../art/asuka.txt?raw';
import { getPublishedPosts } from '../lib/posts.mjs';

const posts = (await getPublishedPosts()).reverse();
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <PathNav segments={[{ label: 'Home' }]} />
      <h1 id="hero-title">&lt;随笔 /&gt;</h1>
      <p>一些日常，一些想法。以后也可能写写技术。</p>
    </div>
    <pre class="ascii-art" aria-label="明日香的字符画" role="img">{asukaArt}</pre>
  </section>

  <PostList posts={posts} title="最近更新" id="latest" />
</BaseLayout>
