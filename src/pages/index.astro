---
import BaseLayout from '../layouts/BaseLayout.astro';
import PathNav from '../components/PathNav.astro';
import asukaArt from '../art/asuka.txt?raw';
import { getPublishedPosts, postUrl } from '../lib/posts.mjs';

const posts = (await getPublishedPosts()).reverse();

const formatDate = (value) => new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Asia/Shanghai',
}).format(new Date(`${value}T00:00:00+08:00`));
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <PathNav segments={[{ label: '文章', href: '#articles' }]} />
      <h1 id="hero-title">&lt;随笔 /&gt;</h1>
      <p>一些日常，一些想法。以后也可能写写技术。</p>
    </div>
    <pre class="ascii-art" aria-label="明日香的字符画" role="img">{asukaArt}</pre>
  </section>

  <section class="archive" id="articles" aria-labelledby="archive-title">
    <div class="section-heading">
      <h2 id="archive-title">文章</h2>
      <span class="article-count">{posts.length} 篇</span>
    </div>

    <div class="post-list">
      {posts.map((post) => (
        <a class="post-row" href={postUrl(post)}>
          <span class="post-main">
            <strong>{post.data.title}</strong>
            <span class="post-summary">{post.data.description}</span>
          </span>
          <span class="post-date">{formatDate(post.data.pubDate)}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
