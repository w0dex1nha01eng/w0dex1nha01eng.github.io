---
import BaseLayout from './BaseLayout.astro';
import PathNav from '../components/PathNav.astro';
import { postUrl } from '../lib/posts.mjs';

const { frontmatter, previous, next } = Astro.props;
const date = new Date(`${frontmatter.pubDate}T00:00:00+08:00`);
const dateLabel = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Shanghai',
}).format(date);
---

<BaseLayout title={`${frontmatter.title} · w0dex1nha01eng`} description={frontmatter.description}>
  <article class="post-page">
    <PathNav segments={[{ label: '文章', href: '/#articles' }, { label: frontmatter.title }]} />
    <header class="post-header">
      <p class="eyebrow"><time datetime={frontmatter.pubDate}>{dateLabel}</time></p>
      <h1>{frontmatter.title}</h1>
      <p class="post-description">{frontmatter.description}</p>
    </header>
    <div class="prose"><slot /></div>
    <nav class="post-pagination" aria-label="相邻文章">
      {previous
        ? <a class="post-pagination-link" href={postUrl(previous)} aria-label={`上一篇：${previous.data.title}`}>← 上一篇</a>
        : <span class="post-pagination-link is-disabled" aria-disabled="true">← 上一篇</span>}
      {next
        ? <a class="post-pagination-link" href={postUrl(next)} aria-label={`下一篇：${next.data.title}`}>下一篇 →</a>
        : <span class="post-pagination-link is-disabled" aria-disabled="true">下一篇 →</span>}
    </nav>
  </article>
</BaseLayout>
